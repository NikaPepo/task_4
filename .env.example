# Environment template — copy to .env and fill in your values, OR set real env vars.
# Real environment variables win over .env files.
#
# Files are loaded in this order (later overrides earlier):
#  * .env                defaults
#  * .env.local          local overrides (gitignored)
#  * .env.$APP_ENV       per-environment defaults (gitignored)
#  * .env.$APP_ENV.local per-environment overrides (gitignored)

###> symfony/framework-bundle ###
APP_ENV=dev
# Generate with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=change-me
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Used to generate URLs in non-HTTP contexts (CLI, workers).
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format: mysql://USER:PASSWORD@HOST:PORT/DB?serverVersion=VERSION
DB_USERNAME=app
DB_PASSWORD=
DB_DATABASE=symfony
DATABASE_URL=
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Examples:
#   MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
#   MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer (Gmail SMTP for transactional emails) ###
# Generate an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAILER_DSN=smtp://${GMAIL_USER}:${GMAIL_APP_PASSWORD}@smtp.gmail.com:587?encryption=tls&auth_mode=login
MAILER_FROM_EMAIL=${GMAIL_USER}
MAILER_FROM_NAME=
###< symfony/mailer ###

###> cron (external cron-job.org calls /messenger/consume) ###
# Random secret. Generate with: php -r "echo bin2hex(random_bytes(32));"
# cron-job.org sends this in the X-Cron-Token header on every POST.
CRON_TOKEN=change-me
###< cron ###

###> phpunit/phpunit ###
KERNEL_CLASS=App\Kernel
###< phpunit/phpunit ###
