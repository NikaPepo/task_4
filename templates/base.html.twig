<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}User Management{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><text y=%2214%22 font-size=%2214%22>👤</text></svg>">

        {# IMPORTANT: Bootstrap 5 CSS + Icons, loaded via CDN. No bundler needed. #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

        {# NOTE: app-specific overrides — keep this boring and business-like. #}
        <link href="{{ asset('styles/app.css') }}" rel="stylesheet">

        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-light">

        {# IMPORTANT: top navigation bar — visible to all visitors (logged in or not). #}
        <nav class="navbar navbar-expand-md navbar-dark bg-dark border-bottom mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" href="{{ path('app_users') }}">
                    <i class="bi bi-people-fill me-1"></i> User Management
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto"></ul>
                    <ul class="navbar-nav ms-auto align-items-md-center">
                        {% if app.user %}
                            <li class="nav-item me-md-3">
                                <span class="navbar-text small text-secondary">
                                    <i class="bi bi-person-circle me-1"></i>{{ app.user.userIdentifier }}
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" action="{{ path('app_logout') }}" class="d-inline">
                                    <button class="btn btn-outline-light btn-sm" type="submit">
                                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                                    </button>
                                </form>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm me-2" href="{{ path('app_login') }}">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-light btn-sm" href="{{ path('app_registration') }}">
                                    <i class="bi bi-person-plus me-1"></i>Register
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <main class="container-fluid pb-5">
            {# IMPORTANT: flash messages — alert banners (NOT browser alerts). #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}
            {# NOTE: enable Bootstrap tooltips site-wide. #}
            <script>
                document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
            </script>
        {% endblock %}
    </body>
</html>