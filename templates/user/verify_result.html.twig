{% extends 'base.html.twig' %}

{% block title %}E-mail verification{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-center">
                    {% if success %}
                        <i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>
                        <h1 class="h4 mt-3">E-mail confirmed</h1>
                    {% else %}
                        <i class="bi bi-x-octagon-fill text-danger" style="font-size:3rem"></i>
                        <h1 class="h4 mt-3">Verification failed</h1>
                    {% endif %}
                    <p class="mt-3 mb-4">{{ message }}</p>
                    <a href="{{ path('app_login') }}" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Go to sign in
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}